  <developers>
    <developer>
      <id>laynepenney</id>
      <name>Layne Penney</name>
      <email>layne@laynemobile.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git@github.com:LayneMobile/RxSubscriptions.git</connection>
