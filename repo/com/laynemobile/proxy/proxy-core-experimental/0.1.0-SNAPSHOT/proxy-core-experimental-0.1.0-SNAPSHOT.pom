<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.laynemobile.proxy</groupId>
  <artifactId>proxy-core-experimental</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Proxy-Core</name>
  <description>Core component for Proxy Java library</description>
  <url>https://github.com/LayneMobile/Api</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>laynepenney</id>
      <name>Layne Penney</name>
      <email>layne@laynemobile.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git@github.com:LayneMobile/Api.git</connection>
    <developerConnection>scm:git@github.com:LayneMobile/Api.git</developerConnection>
    <url>https://github.com/LayneMobile/Api</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.laynemobile.proxy</groupId>
      <artifactId>proxy-functions</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>19.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.immutables</groupId>
      <artifactId>value</artifactId>
      <version>2.2.5</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.laynemobile.proxy</groupId>
      <artifactId>proxy-functions-generator</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>2.0.3-beta</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.reactivex</groupId>
      <artifactId>rxjava</artifactId>
      <version>1.1.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
